# Tip: To automatically generate and install this unit for your current directory and user, run:
#      ./scripts/install_service.sh --user --with-litestream --enable-now

[Unit]
Description=Litestream SQLite Continuous Cloud Replication
After=network.target

[Service]
Type=simple
# For system-wide (/etc/systemd/system): Replace with your server username and path
# For user mode (~/.config/systemd/user): Omit User= and use %h for home directory
User=username
WorkingDirectory=/path/to/TARVeri-bot
EnvironmentFile=/path/to/TARVeri-bot/.env
ExecStart=/usr/local/bin/litestream replicate -config /path/to/TARVeri-bot/litestream.yml
Restart=always
RestartSec=5

# Logging: Isolated in journalctl, view with 'journalctl -u litestream -f'
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
