# Tip: To automatically generate and install this unit for your current directory and user, run:
#      ./scripts/install_service.sh --user --enable-now

[Unit]
Description=TARVeri Discord Student Verification Bot
After=network.target

[Service]
Type=simple
# For system-wide (/etc/systemd/system): Replace with your server username and path
# For user mode (~/.config/systemd/user): Omit User= and use %h for home directory
User=username
WorkingDirectory=/path/to/TARVeri-bot
ExecStart=/path/to/TARVeri-bot/.venv/bin/python /path/to/TARVeri-bot/tarveri_bot.py
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT

# Environment
EnvironmentFile=/path/to/TARVeri-bot/.env
StandardOutput=journal
StandardError=journal

# Security Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
