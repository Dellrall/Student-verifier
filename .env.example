# Copy this file to .env and fill in real values. Never commit .env itself.

# Your Discord bot token (Discord Developer Portal → Bot → Token)
TARVERI_BOT_TOKEN=

# Random secret used to hash student IDs at rest.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TARVERI_ID_HASH_SECRET=

# Optional: path to the SQLite DB file (defaults to tarveri.db in the working dir)
TARVERI_DB_PATH=tarveri.db
