# Discord Bot Token from Discord Developer Portal
TARVERI_BOT_TOKEN=your_bot_token_here

# Secret key for HMAC-SHA256 student ID hashing at rest
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
TARVERI_ID_HASH_SECRET=your_32_byte_hex_secret_here

# Optional: Path to SQLite database (default: tarveri.db)
TARVERI_DB_PATH=tarveri.db

# Optional: Name of the role allowed to run admin commands (default: "TARVeri Admin")
TARVERI_ADMIN_ROLE_NAME="TARVeri Admin"

# Optional: Host Maintainer Discord User ID (for receiving private update notifications)
# TARVERI_HOSTER_DISCORD_ID=123456789012345678

# Optional: Enable background update checking (default: true)
TARVERI_ENABLE_UPDATE_CHECKER=true
TARVERI_UPDATE_CHECK_INTERVAL_HOURS=24

# Optional: Update stream/branch to track (default: auto - follows current branch's upstream)
# Options: auto | main | refactor/modular-optimization | <branch_name>
TARVERI_UPDATE_STREAM=auto

# Optional: Specific Help Channel ID (autodetects channels with 'help', 'faq', 'support' if unset)
# TARVERI_HELP_CHANNEL_ID=123456789012345678

# Optional: Specific Welcome Channel ID to tag new members (autodetects 'welcome', 'verify', or system channel if unset)
# TARVERI_WELCOME_CHANNEL_ID=123456789012345678

# Optional: Timezone for terminal logs, database records, and audit timestamps (default: Asia/Kuala_Lumpur)
# Options: Asia/Kuala_Lumpur | UTC | auto | local | system | ZoneInfo string
TARVERI_TIMEZONE=Asia/Kuala_Lumpur

# Optional: Directory and retention count for database backups (default: backups / 10)
TARVERI_BACKUP_DIR=backups
TARVERI_MAX_BACKUPS=10

# Optional: Network & Power Outage Detection Watchdog (default: true / 300s timeout / 15s probe)
TARVERI_ENABLE_OUTAGE_WATCHDOG=true
TARVERI_OUTAGE_TIMEOUT_SECONDS=300
TARVERI_OUTAGE_PROBE_INTERVAL_SECONDS=15

# ==============================================================================
# Optional: Institutional Student Email Verification & AES-256 Encryption
# ==============================================================================
# Enable two-factor OTP verification sent to @student.tarc.edu.my before assigning roles
TARVERI_EMAIL_VERIFICATION_ENABLED=false
TARVERI_EMAIL_ALLOWED_DOMAINS=student.tarc.edu.my,tarc.edu.my

# AES-256 Fernet symmetric key for encrypting student emails at rest in SQLite
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TARVERI_EMAIL_ENCRYPTION_KEY=your_base64_fernet_encryption_key_here

# Primary SMTP Relay Settings (e.g. SMTP2GO / Amazon SES / Brevo / SendGrid)
TARVERI_SMTP_HOST=mail.smtp2go.com
TARVERI_SMTP_PORT=587
TARVERI_SMTP_USER=your_smtp2go_username
TARVERI_SMTP_PASSWORD=your_smtp2go_password
TARVERI_SMTP_FROM_EMAIL=noreply@yourdomain.com
TARVERI_SMTP_FROM_NAME="TARVeri Student Verification"
TARVERI_SMTP_USE_TLS=true

# Fallback Direct Email Server SMTP Settings (Auto-failover when SMTP2GO limit/quota runs out or encounters error)
TARVERI_SMTP_FALLBACK_HOST=mail.yourdomain.com
TARVERI_SMTP_FALLBACK_PORT=587
TARVERI_SMTP_FALLBACK_USER=verify@yourdomain.com
TARVERI_SMTP_FALLBACK_PASSWORD=your_mailbox_password
TARVERI_SMTP_FALLBACK_FROM_EMAIL=verify@yourdomain.com
TARVERI_SMTP_FALLBACK_FROM_NAME="TARVeri Student Verification"
TARVERI_SMTP_FALLBACK_USE_TLS=true

# Security OTP Limits
TARVERI_EMAIL_OTP_TTL_SECONDS=600
TARVERI_EMAIL_OTP_MAX_ATTEMPTS=3
TARVERI_EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
